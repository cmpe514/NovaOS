# %%NAME%% boot splash (Plymouth script plugin). Colours match the shell: #080d18 → #101a30.
Window.SetBackgroundTopColor(0.031, 0.051, 0.094);
Window.SetBackgroundBottomColor(0.063, 0.102, 0.188);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetPosition(logo.x, logo.y, 1);

track.image = Image("track.png");
track.sprite = Sprite(track.image);
track.x = Window.GetX() + Window.GetWidth() / 2 - track.image.GetWidth() / 2;
track.y = logo.y + logo.image.GetHeight() + 40;
track.sprite.SetPosition(track.x, track.y, 1);

bar.original = Image("bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(track.x, track.y, 2);

fun progress_callback(duration, progress) {
    width = Math.Int(bar.original.GetWidth() * progress);
    if (width < 1) width = 1;
    bar.sprite.SetImage(bar.original.Scale(width, bar.original.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Password prompts (e.g. an encrypted disk) and messages stay readable.
message.sprite = Sprite();
fun message_callback(text) {
    message.image = Image.Text(text, 0.84, 0.89, 0.95);
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - message.image.GetWidth() / 2, track.y + 40, 3);
}
Plymouth.SetMessageFunction(message_callback);
