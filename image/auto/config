#!/bin/sh
# live-build configuration for %%NAME%% %%VERSION%% (%%ARCH%%). Rendered by tools/build-iso.sh — edit
# image/auto/config, not the copy in the build directory.
set -e
lb config noauto \
  --mode debian \
  --system live \
  --distribution "%%SUITE%%" \
  --architecture "%%ARCH%%" \
  --archive-areas "main contrib non-free-firmware" \
  --mirror-bootstrap "%%MIRROR%%" \
  --mirror-chroot "%%MIRROR%%" \
  --mirror-chroot-security "%%MIRROR_SECURITY%%" \
  --mirror-binary "https://deb.debian.org/debian/" \
  --mirror-binary-security "https://security.debian.org/debian-security/" \
  --security true \
  --updates true \
  --binary-images iso-hybrid \
  --bootloaders "%%BOOTLOADERS%%" \
  --debian-installer none \
  --apt-recommends false \
  --apt-indices false \
  --firmware-chroot true \
  --firmware-binary false \
  --linux-flavours "%%FLAVOUR%%" \
  --bootappend-live "%%APPEND%%" \
  --iso-application "%%NAME%%" \
  --iso-volume "%%ISO_VOLUME%%" \
  --iso-publisher "%%NAME%% (https://github.com/cmpe514/NovaOS)" \
  --memtest none \
  --chroot-squashfs-compression-type xz \
  --cache-packages true \
  %%EXTRA_LB_OPTIONS%% \
  "${@}"
